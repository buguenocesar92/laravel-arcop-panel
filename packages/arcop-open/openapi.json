      "post": {
        "summary": "Receives a request as identity_pending",
        "description": "Receives a request as identity_pending. Does not verify identity, decide legality or execute changes in the host system. Returns id/status; an identical replay also returns replayed=true.",
        "parameters": [
          {
            "in": "header",
            "name": "X-Tenant-ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Reuse only for identical payload. Conflicting reuse returns 409."
          }
        ],
        "responses": {
          "200": {
            "description": "Success. See endpoint description for result fields.",
            "content": {
              "application/json": {
                "schema": {
                  "type": [
                    "object",
                    "array"
                  ]
                }
              }
