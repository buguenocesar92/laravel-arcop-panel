    "/requests/{id}/transitions": {
      "post": {
        "summary": "Applies role/state/evidence guards",
        "description": "Applies role/state/evidence guards. Approval/rejection require reviewed legal profile and a different resolver from receiver. Completion requires a host execution receipt. The source legal decision/evidence must be retained by the host.",
        "parameters": [
          {
            "in": "header",
            "name": "X-Tenant-ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
