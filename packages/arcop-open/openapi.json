        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "product": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 120
                  },
                  "identity": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 255
                  },
                  "right_type": {
                    "type": "string",
                    "enum": [
                      "access",
                      "rectification",
                      "erasure",
                      "opposition",
                      "portability"
                    ]
                  },
                  "description": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 4000
                  },
                  "legal_profile": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 80
                  }
                },
                "required": [
                  "product",
                  "identity",
                  "right_type",
                  "description"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
