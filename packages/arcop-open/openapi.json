                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "verify_identity",
                      "approve",
                      "reject",
                      "complete"
                    ]
                  },
                  "evidence_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "legal_basis": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 2000
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 2000
                  },
                  "receipt_ref": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 255
                  }
                },
                "required": [
                  "action",
                  "evidence_sha256"
                ],
                "additionalProperties": false
              }
            }
          }
        }
